{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/schemas/resident-manifest-v1.json",
  "title": "Chronicle resident manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "match", "home", "soul", "skills", "memory", "routes", "app_grants"],
  "properties": {
    "manifest_version": { "const": 1 },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": { "$ref": "#/$defs/identifier" },
        "project": { "$ref": "#/$defs/identifier" }
      },
      "oneOf": [
        { "required": ["agent_id"] },
        { "required": ["project"] }
      ]
    },
    "home": { "type": "integer", "minimum": 0, "maximum": 7 },
    "soul": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "char", "accent", "role", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "char": { "enum": ["Villager", "Villager2", "Villager3", "Villager4", "Villager5", "Woman", "Boy", "OldMan", "Princess", "Hunter", "Noble", "Monk"] },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "role": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "skills": { "$ref": "#/$defs/references" },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "status_ref"],
      "properties": { "ref": { "$ref": "#/$defs/status_reference" }, "status_ref": { "$ref": "#/$defs/status_reference" } }
    },
    "routes": { "$ref": "#/$defs/references" },
    "app_grants": { "$ref": "#/$defs/references" },
    "routines": { "type": "array", "items": { "$ref": "#/$defs/routine" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "steward_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "status_reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status_ref"],
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "status_ref": { "$ref": "#/$defs/status_reference" } }
    },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "routine": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schedule", "schedule_tz", "steward_resident"],
      "properties": {
        "id": { "$ref": "#/$defs/steward_slug" },
        "schedule": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9*?,/#._%+\\-]+(?: [A-Za-z0-9*?,/#._%+\\-]+){4}$"
        },
        "schedule_tz": {
          "type": "string",
          "anyOf": [
            { "pattern": "^[A-Za-z][A-Za-z0-9._+-]*(?:/[A-Za-z][A-Za-z0-9._+-]*)+$" },
            { "enum": ["CET", "CST6CDT", "Cuba", "EET", "EST", "EST5EDT", "Egypt", "Eire", "Factory", "GB", "GB-Eire", "GMT", "GMT+0", "GMT-0", "GMT0", "Greenwich", "HST", "Hongkong", "Iceland", "Iran", "Israel", "Jamaica", "Japan", "Kwajalein", "Libya", "MET", "MST", "MST7MDT", "NZ", "NZ-CHAT", "Navajo", "PRC", "PST8PDT", "Poland", "Portugal", "ROC", "ROK", "Singapore", "Turkey", "UCT", "UTC", "Universal", "W-SU", "WET", "Zulu"] }
          ]
        },
        "steward_resident": { "$ref": "#/$defs/steward_slug" },
        "enabled": { "type": "boolean", "default": true }
      }
    }
  }
}
