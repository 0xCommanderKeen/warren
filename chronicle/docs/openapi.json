          "resident_file",
          "state",
          "project",
          "cwd",
          "last_ts",
          "last_line",
          "place",
          "lineage",
          "history",
          "mood",
          "pending_approval_ids"
        ],
        "title": "VillagerWire",
        "type": "object"
      }
    }
  },
